{
  "title": "EduMetria — API e jobs (RED)",
  "uid": "edumetria-red",
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "Requisições por classe de status", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "sum by (status_class) (rate(edumetria_http_requests_total[5m]))", "legendFormat": "{{status_class}}"}]},
    {"type": "timeseries", "title": "Latência média por rota (s)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "sum by (route) (rate(edumetria_http_request_duration_seconds_sum[5m])) / sum by (route) (rate(edumetria_http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}}"}]},
    {"type": "stat", "title": "Jobs por status (lido do banco)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "sum by (status) (edumetria_jobs_by_status)", "legendFormat": "{{status}}"}]},
    {"type": "stat", "title": "Duração média de job concluído (s)", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "max(edumetria_job_mean_duration_seconds)"}]}
  ]
}
